# Hugging Face Inference API (지역 AI 한줄 요약)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3.5-35B-A3B
HUGGINGFACE_TEMPERATURE=0.2

# 선택: OpenAI 호환 chat completions 엔드포인트
# HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions

# 선택: 생성 파라미터
# HUGGINGFACE_MAX_TOKENS=1500

# AI 컨설팅 지역 특화용 웹 검색 (선택)
# 키가 없어도 한국어 위키백과 검색은 동작합니다.
# TAVILY_API_KEY=          # https://tavily.com
# SERPER_API_KEY=          # https://serper.dev

# 지도 베이스맵 (MapLibre). 기본값: OpenFreeMap Liberty
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
